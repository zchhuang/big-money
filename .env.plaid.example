# Copy using: node bin/setup-plaid.mjs
# Credentials stay on the server. Never use VITE_* for Plaid secrets.
PLAID_ENABLED=false
PLAID_ENV=sandbox
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENCRYPTION_KEY=
PLAID_PRODUCTS=transactions
PLAID_OPTIONAL_PRODUCTS=investments,liabilities
PLAID_COUNTRY_CODES=US
# Optional, registered HTTPS OAuth redirect (required by some institutions):
PLAID_REDIRECT_URI=
# Optional, publicly reachable HTTPS URL ending /plaid/webhook:
PLAID_WEBHOOK_URL=
ACTUAL_HOSTNAME=127.0.0.1
ACTUAL_PORT=5006
ACTUAL_DATA_DIR=.local-data

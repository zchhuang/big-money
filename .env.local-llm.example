# Copy to .local-data/local-llm.env (ignored by Git); create .local-data first.
# Replace the model name with the identifier exposed by your local server.
# Empty disables model suggestions; saved-correction learning still works.
ACTUAL_LOCAL_MODEL=
# LM Studio endpoint. For Ollama, change port 1234 to 11434.
ACTUAL_LOCAL_MODEL_URL=http://127.0.0.1:1234/v1/chat/completions
# This file is not loaded automatically. Export its values before running the CLI:
# set -a; source .local-data/local-llm.env; set +a
# The local server and model must already be running; no downloads are triggered.
